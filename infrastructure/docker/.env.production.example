# Copy to .env.production on the VM (never commit it) and fill in.
POSTGRES_PASSWORD=
DOMAIN=localhost            # only read by Caddy, unused in tunnel mode
ACME_EMAIL=you@example.com  # only read by Caddy, unused in tunnel mode
JWT_SECRET=                 # openssl rand -base64 32
ADMIN_BOOTSTRAP_TOKEN=      # openssl rand -base64 32
TOTP_ENCRYPTION_KEY=        # openssl rand -base64 32
ADMIN_EMAIL=
ADMIN_SEED_PASSWORD=
LLM_PROVIDER=omniroute
LLM_BASE_URL=https://api.omniroute.ai/v1
LLM_API_KEY=
LLM_MODEL_ANALYZE=
LLM_MODEL_WRITE=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                # Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
