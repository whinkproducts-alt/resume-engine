# Copy to .env.production (same folder) and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -base64 32     (use -hex 24 for POSTGRES_PASSWORD)

# --- Host ---
DOMAIN=resume.example.com
ACME_EMAIL=you@example.com

# --- Database (URL safe characters only: use hex) ---
POSTGRES_PASSWORD=

# --- API ---
JWT_SECRET=
ADMIN_EMAIL=Whinkproducts@gmail.com
ADMIN_SEED_PASSWORD=
ADMIN_BOOTSTRAP_TOKEN=
# 32 random bytes, base64: encrypts admin 2FA seeds
TOTP_ENCRYPTION_KEY=

# --- LLM ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL_ANALYZE=
LLM_MODEL_WRITE=

# --- Object storage (S3 or Cloudflare R2) ---
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# R2 only: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_SIGNED_URL_TTL_SECONDS=900

# --- Worker ---
WORKER_CONCURRENCY=3
