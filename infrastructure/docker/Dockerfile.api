# syntax=docker/dockerfile:1
# One image for the API and the worker (they share a build). The worker needs
# LibreOffice and the Carlito font (metric compatible with Calibri) for the PDF step.
# Build from the repository root:  docker build -f infrastructure/docker/Dockerfile.api .

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH HUSKY=0
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate && chmod -R a+rX /opt/corepack
WORKDIR /app

FROM base AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN pnpm install --frozen-lockfile --filter "@resume-engine/api..."
# prisma generate needs a URL to parse, not a database
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build \
    pnpm --filter @resume-engine/api prisma:generate
RUN pnpm --filter "@resume-engine/api..." build

FROM base AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssl ca-certificates fontconfig libreoffice-writer fonts-crosextra-carlito fonts-liberation \
 && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production SOFFICE_PATH=/usr/bin/soffice
COPY --from=build --chown=node:node /app /app
USER node
WORKDIR /app/apps/api
EXPOSE 3001
# API by default. The worker overrides this with:  node dist/workers/worker-main.js
CMD ["/app/infrastructure/docker/start-api.sh"]
