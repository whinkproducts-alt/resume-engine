{
  "name": "@resume-engine/api",
  "version": "1.0.0",
  "private": true,
  "description": "Resume Engine API (NestJS) and pipeline worker",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch",
    "worker": "node --env-file-if-exists=.env dist/workers/worker-main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "dev": "nest start --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.22.0",
    "@resume-engine/qa": "workspace:*",
    "@resume-engine/renderer": "workspace:*",
    "@resume-engine/rules": "workspace:*",
    "@resume-engine/storage": "workspace:*",
    "argon2": "^0.41.1",
    "axios": "^1.7.0",
    "bullmq": "^5.12.0",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "mammoth": "^1.8.0",
    "node-html-parser": "^6.1.13",
    "openai": "^4.58.0",
    "otplib": "^12.0.1",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@nestjs/testing": "^10.4.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "unplugin-swc": "^1.5.1",
    "@swc/core": "^1.7.0"
  }
}
