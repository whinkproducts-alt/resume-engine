NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_engine?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-32-byte-random-base64

# Admin provisioning — secret store only in production
ADMIN_EMAIL=Whinkproducts@gmail.com
ADMIN_SEED_PASSWORD=replace-with-strong-unique-password
ADMIN_BOOTSTRAP_TOKEN=replace-with-random-32-byte-base64

# .env.example  (Stage 3 additions)
# --- Storage (S3 or Cloudflare R2) ---
S3_BUCKET=resume-engine-artifacts
S3_REGION=auto
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_SECONDS=900

# --- PDF QA ---
SOFFICE_PATH=/usr/bin/soffice
PDF_CONVERSION_TIMEOUT_MS=120000
MAX_PAGES=3

# --- Validator ---
RULE_MAX_RETRIES=2
ROLE_OVERLAP_THRESHOLD=0.70

