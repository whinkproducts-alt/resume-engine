# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# apps/web  (Next.js)
# ---------------------------------------------------------------------------
# Auth — HttpOnly refresh cookie flows through this same origin in prod
NEXT_PUBLIC_AUTH_LOGIN_PATH=/api/auth/login
NEXT_PUBLIC_AUTH_REFRESH_PATH=/api/auth/refresh

# ---------------------------------------------------------------------------
# apps/api  (only if backend lives in this repo)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://user:pass@localhost:5432/resume_engine
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
BOOTSTRAP_TOKEN=change-me                   # sent via X-Bootstrap-Token header
OPENAI_API_KEY=sk-...                       # for R9 LLM-judged flags
REDIS_URL=redis://localhost:6379            # run queue
